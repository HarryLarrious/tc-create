// Events, chat commands and the main loop.

declare global cLoopId: num;
declare global cLastBeat: num;

gameevent startup {
    rebuildAll();
    ensureLoop();
}

playerevent join {
    packSend();
    ensureLoop();
    default.sendMessage(s"<gold>Create</gold> <gray>— type <yellow>@kit</yellow> for the blocks, wrench and goggles, <yellow>@help</yellow> for the rest.");
    // players already in a proxy are hidden behind their mannequins
    for (line u of global pMode.getKeys()) {
        if (global pMode[line u as str] == 1) {
            default.setEntityHidden(line u as str);
        }
    }
}

playerevent leave {
    proxyDrop(default.uuid);
}

playerevent dismount {
    // shift would drop a proxy player off their stand: it sneaks instead
    if (inProxy(default.uuid) == 1 && dNum(global pLeaving, default.uuid, 0) == 0) {
        event.cancel();
    }
}

playerevent rightClick {
    select playersByName(default.uuid);
    useClick();
    select reset;
}

playerevent rightClickEntity {
    select playersByName(default.uuid);
    useClick();
    select reset;
}

playerevent leftClick {
    select playersByName(default.uuid);
    hitClick();
    select reset;
}

playerevent damageEntity {
    // a left click on a block's hitbox
    event.cancel();
    select playersByName(default.uuid);
    hitClick();
    select reset;
}

playerevent command {
    line words = event.command.split(" ");
    line cmd = (line words[1] as str).replace("@", "");
    if (line cmd == "kit") {
        giveKit();
    } else if (line cmd == "clearcreate") {
        clearAll();
        default.sendMessage(s"<gray>Removed every Create block.");
    } else if (line cmd == "reload") {
        rebuildAll();
        line n = global kType.len();
        default.sendMessage(s"<gray>Rebuilt %var(n) blocks.");
    } else if (line cmd == "demo") {
        buildDemo();
        default.sendMessage(s"<gray>Built a demo line to the east. Right click the motor to speed it up.");
    } else if (line cmd == "look") {
        // @look pitch yaw: points the camera (for testing)
        default.setRotation(num.parse(line words[2] as str), num.parse(line words[3] as str));
    } else if (line cmd == "dbg") {
        // every block: type, speed, generated speed, network
        line nd = global kDirty.len();
        line beat = global cLastBeat;
        line now = game.ticksSinceStartup;
        line lid = global cLoopId;
        default.sendMessage(s"<yellow>dirty %var(nd) beat %var(beat) now %var(now) loop %var(lid)");
        if (line words.len() > 1) {
            line k1 = global kType.getKeys()[1] as str;
            line links = kLinks(line k1);
            line ln = line links.len();
            line r = solveNetwork(line k1);
            default.sendMessage(s"<yellow>%var(k1) links %var(ln) solve %var(r)");
        }
        for (line k of global kType.getKeys()) {
            line t = global kType[line k as str];
            line sp = speedAt(line k as str);
            line g = genAt(line k as str);
            line nt = netOf(line k as str);
            line np = partsAt(line k as str).len();
            default.sendMessage(s"<gray>%var(k) <white>%var(t)</white> speed %var(sp) gen %var(g) net %var(nt) parts %var(np)");
        }
    } else if (line cmd == "proxydbg") {
        global pDebug = 1 - global pDebug;
    } else if (line cmd == "tp") {
        // @tp x y z [yaw pitch]: for testing
        line yaw = 0;
        line pitch = 0;
        if (line words.len() >= 6) {
            line yaw = num.parse(line words[5] as str);
            line pitch = num.parse(line words[6] as str);
        }
        if (inProxy(default.uuid) == 1) {
            select playersByName(default.uuid);
            proxyRelease(default.uuid);
            select reset;
        }
        default.teleport(loc(num.parse(line words[2] as str), num.parse(line words[3] as str), num.parse(line words[4] as str), line pitch, line yaw));
    } else if (line cmd == "testkit") {
        // a hotbar for trying the machines
        default.clearInventory();
        default.setHotbarItems(item("iron_ingot", 16), item("wheat", 16), toolItem("goggles"), toolItem("wrench"), item("cobblestone", 16), item("air"), kitItem("shaft"), kitItem("cogwheel"), kitItem("gearbox"));
    } else if (line cmd == "pack") {
        packSend();
    } else if (line cmd == "stats") {
        line nb = global kType.len();
        line nn = global netCap.len();
        line cpu = num.round(game.cpuUsage);
        default.sendMessage(s"<gray>%var(nb) blocks, %var(nn) networks, CPU %var(cpu)%.");
    } else if (line cmd == "help") {
        default.sendMessage(s"<gold>Create</gold> <gray>commands:");
        default.sendMessage(s"<yellow>@kit</yellow> <gray>every block, a wrench and goggles; <yellow>@demo</yellow> <gray>builds a working line of machines east of you");
        default.sendMessage(s"<gray>Right click a face with a block to place it; left click breaks. Wrench: right click turns a block, sneak + right click picks it up. Goggles (right click to wear) show speed and stress.");
        default.sendMessage(s"<gray>Hand crank: right click (sneak: backwards). Creative motor: right click for faster, sneak + right click slower. Depot / millstone: right click to put an item in or take it out.");
        default.sendMessage(s"<yellow>@clearcreate</yellow> <gray>removes every block, <yellow>@reload</yellow> rebuilds them, <yellow>@stats</yellow>, <yellow>@pack</yellow>");
    }
}

function ensureLoop {
    // (also right after startup, when no loop has beaten yet)
    if (global cLoopId == 0 || game.ticksSinceStartup - global cLastBeat > 5) {
        start createLoop;
    }
}

/** Every tick: networks, machines, and each player's proxy and goggles. */
process createLoop {
    global cLoopId += 1;
    line myId = global cLoopId;
    repeat {
        if (global cLoopId != line myId) {
            break;
        }
        global cLastBeat = game.ticksSinceStartup;
        line tick = global cLastBeat;
        solveDirty();
        machinesTick(line tick);
        for (line u of game.plotPlayerUUIDs) {
            select playersByName(line u as str);
            if (game.selectionSize > 0) {
                proxyTick(line u as str);
                if (line tick % 4 == 0) {
                    gogglesTick();
                }
            }
            select reset;
        }
        wait;
    }
}
